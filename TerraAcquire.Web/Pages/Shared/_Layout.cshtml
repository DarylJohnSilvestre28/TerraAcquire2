<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>TerraAcquire</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/main.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            padding-top: 70px; 
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            z-index: 1100;
            background-color: #000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
        }

        .navbar-left {
            font-weight: bold;
            font-size: 24px;
            color: yellowgreen;
        }

        .navbar-right a {
            font-size: 16px;
            margin: 0 5px;
            padding: 6px 15px;
            border: 2px solid yellowgreen;
            border-radius: 25px;
            text-decoration: none;
            color: yellowgreen;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }

            .navbar-right a:hover {
                background-color: yellowgreen;
                color: #fff;
            }

        .navbar-right .mainpage-link {
            color: yellowgreen;
            border: 2px solid yellowgreen;
        }
    </style>
</head>

<body>

    <div class="navbar">
        <div class="navbar-left">TerraAcquire</div>
        <div class="navbar-right">
            <a href="/"><i class="bi bi-house-door-fill me-1"></i> Home</a>
            <a href="/ModelHouse3D">
                <i class="bi bi-building me-1"></i> Model Houses</a>
            <a href="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
            <a href="/Account/Signup"><i class="bi bi-person-plus-fill me-1"></i> Sign Up</a>
            <a class="nav-link mainpage-link" asp-page="/Manage/ModelHouses/MainPage">
                <i class="bi bi-speedometer2 me-1"></i> Main Page
            </a>
        </div>
    </div>


    <div class="container">
        @RenderBody()
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
