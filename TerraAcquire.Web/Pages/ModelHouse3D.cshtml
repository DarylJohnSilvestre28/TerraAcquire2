@page
@model ModelHousesModel
@{
    ViewData["Title"] = "Model Houses";
    Layout = "_Layout";
}

<style>
    .title-oblong {
        display: inline-block;
        padding: 10px 30px;
        border: 3px solid yellowgreen;
        border-radius: 50px;
        background-color: rgba(255, 255, 255, 0.8);
        color: black;
        font-weight: bold;
        box-shadow: 0 0 10px yellowgreen;
    }

    body {
        background: url('@Url.Content("https://images.pexels.com/photos/259588/pexels-photo-259588.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1")') no-repeat center center fixed;
        background-size: cover;
        background-color: #2c3e50;
    }

    .overlay {
        background-color: transparent;
        min-height: 100vh;
        padding: 50px;
    }

    .card-yellowgreen {
        border: 3px solid yellowgreen;
        border-radius: 50px;
        transition: box-shadow 0.3s ease;
        background-color: white;
        overflow: hidden;
    }

        .card-yellowgreen:hover {
            box-shadow: 0 0 15px yellowgreen;
        }

    .card-text, .card-title {
        color: #333;
    }


    .house-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-bottom-left-radius: 60px;
        border-bottom-right-radius: 60px;
        border-top-left-radius: 60px;
        border-top-right-radius: 60px;
        cursor: pointer;
    }
</style>

<div class="overlay">
    <div class="text-center mb-4">
        <h1 class="title-oblong">Model Houses</h1>
    </div>

    @if (Model.Houses != null && Model.Houses.Any())
    {
        <div class="row justify-content-center text-center">
            @foreach (var house in Model.Houses)
            {
                <div class="col-md-4 mb-4 d-flex justify-content-center">
                    <div class="card shadow-sm h-100 card-yellowgreen" style="width: 18rem;">
                        <div class="card-body text-center">
                            <h5 class="card-title">@house.Name</h5>
                            <p class="card-text">
                                <strong>Location:</strong> @house.Location <br />
                                <strong>Price:</strong> @house.Price.ToString("C") <br />
                                <strong>Bedrooms:</strong> @house.Bedrooms <br />
                                <strong>Bathrooms:</strong> @house.Bathrooms
                            </p>
                        </div>
                        <a href="@house.ImageUrl" data-lightbox="houses" data-title="@house.Name">
                            <img src="@house.ImageUrl" class="card-img-bottom house-img" alt="@house.Name" />
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-white">No model houses available.</p>
    }
</div>
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true" aria-labelledby="imageModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0">
                <img id="modalImage" src="" class="img-fluid rounded" alt="House Image" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const modalImage = document.getElementById('modalImage');
        const imageModal = document.getElementById('imageModal');

        imageModal.addEventListener('show.bs.modal', function (event) {
            const triggerImg = event.relatedTarget;
            const imgUrl = triggerImg.getAttribute('data-img-url');
            modalImage.src = imgUrl;
        });
    </script>
}