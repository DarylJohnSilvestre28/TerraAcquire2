@page
@model TerraAcquire.Web.Pages.Customer.CustomerSignupModel
@{
    ViewData["Title"] = "Customer Signup";
}

<h2>Customer Signup</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Customer.FullName"></label>
        <input asp-for="Customer.FullName" class="form-control" />
        <span asp-validation-for="Customer.FullName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Customer.Email"></label>
        <input asp-for="Customer.Email" class="form-control" />
        <span asp-validation-for="Customer.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Customer.Password"></label>
        <input asp-for="Customer.Password" class="form-control" type="password" />
        <span asp-validation-for="Customer.Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Sign Up</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}